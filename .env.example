# The evaluation connects to existing model servers. It does not download or start models.
# Copy to .env. Do not commit real credentials.
# MODEL is the endpoint's served model name, which may differ from its Hugging Face ID.
GPT_OSS_BASE_URL=http://localhost:8000/v1
GPT_OSS_MODEL=gpt-oss-120b
GPT_OSS_API_KEY=EMPTY
GPT_OSS_REVISION=unspecified
GPT_OSS_EXTRA_BODY='{"reasoning_effort":"low"}'
# Released GPT-OSS baseline and ablations use temperature 0.
GPT_OSS_TEMPERATURE=0

KIMI_BASE_URL=http://localhost:8001/v1
KIMI_MODEL=moonshotai/Kimi-K2.5
KIMI_API_KEY=EMPTY
KIMI_REVISION=unspecified
# vLLM/SGLang K2.5 Instant. Adjust to the actual backend (see README).
KIMI_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false},"top_p":0.95}'
KIMI_TEMPERATURE=0.6

# Optional controls (command-line environment overrides if not assigned here):
# GPT_OSS_WORKERS=1
# KIMI_WORKERS=1
# GPT-OSS ablation controls (baseline launcher has separate defaults):
# MAX_TOKENS=8192
# HISTORY_WINDOW=10
# TIMEOUT_SECONDS=300
# PER_LEVEL=200
# LEVELS="TRIVIAL EASY MEDIUM HARD EXPERT"
# MODELS="gpt-oss kimi"
# POLICIES="vanilla guarded"
# VARIANTS="full_minus_accuse delay_control prompt_ledger"
# OUTPUT_DIR=results/gpt_oss_guarded_ablations
# MAX_ACCUSE_BLOCKS=2
# RETRY_ROUNDS=2
